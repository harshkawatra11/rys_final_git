{
  "headers": [
    {
      "source": "/images/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "rajdhaniyuvasansad.com"
        }
      ],
      "destination": "https://www.rajdhaniyuvasansad.com/$1",
      "permanent": true
    }
  ]
}
